    <!-- JAVASCRIPT LOGIC -->
    <script>
        // GLOBAL STATE MANAGEMENT
        const APP_STATE = {
            currentStep: 'page-home',
            cameraStream: null,
            capturedPhotos: [null, null, null, null], // Base64 data URLs for 4 photos
            selectedFilter: 'newspaper',
            priceAmount: 10000,
            qrisImageSrc: 'https://placehold.co/300x300/ffffff/000000?text=QRIS+RESMI+PPG',
            gasWebhookUrl: '',
            isCapturingSession: false
        };

        // Initialize Lucide Icons on load
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            updateStepNav('page-home');
        });

        // PAGE NAVIGATION CONTROLLER
        function navigateTo(pageId) {
            const pages = ['page-home', 'page-camera', 'page-filter', 'page-poster', 'page-payment', 'page-summary'];
            pages.forEach(p => {
                const el = document.getElementById(p);
                if (el) el.classList.add('hidden');
            });

            const targetPage = document.getElementById(pageId);
            if (targetPage) {
                targetPage.classList.remove('hidden');
                APP_STATE.currentStep = pageId;
                updateStepNav(pageId);
            }

            // Page specific triggers
            if (pageId === 'page-camera' && !APP_STATE.cameraStream) {
                initCamera();
            }
        }

        function updateStepNav(pageId) {
            const stepMap = {
                'page-home': 1,
                'page-camera': 2,
                'page-filter': 3,
                'page-poster': 4,
                'page-payment': 5,
                'page-summary': 5
            };
            const currentNum = stepMap[pageId] || 1;

            for (let i = 1; i <= 5; i++) {
                const nav = document.getElementById(`step-nav-${i}`);
                if (nav) {
                    if (i === currentNum) {
                        nav.className = "px-2 py-1 bg-ink text-parchment font-bold rounded";
                    } else if (i < currentNum) {
                        nav.className = "px-2 py-1 bg-parchment-dark text-ink font-bold rounded border border-ink/40";
                    } else {
                        nav.className = "px-2 py-1 text-ink/60";
                    }
                }
            }
        }

        // ================= CAMERA MODULE =================
        async function initCamera() {
            const videoEl = document.getElementById('webcam-video');
            const placeholder = document.getElementById('camera-placeholder');
            const statusEl = document.getElementById('camera-status');
            const btnStart = document.getElementById('btn-start-session');
            const errorMsg = document.getElementById('camera-error-msg');

            errorMsg.classList.add('hidden');

            try {
                const constraints = {
                    video: {
                        width: { ideal: 1280 },
                        height: { ideal: 960 },
                        facingMode: 'user'
                    },
                    audio: false
                };

                const stream = await navigator.mediaDevices.getUserMedia(constraints);
                APP_STATE.cameraStream = stream;
                videoEl.srcObject = stream;
                
                // Hide placeholder upon video play
                videoEl.onloadedmetadata = () => {
                    placeholder.classList.add('hidden');
                    statusEl.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-green-600 animate-pulse"></span> Kamera Aktif';
                    statusEl.className = "font-bold text-green-700 flex items-center gap-1";
                    btnStart.disabled = false;
                    btnStart.classList.remove('opacity-50', 'cursor-not-allowed');
                };

            } catch (err) {
                console.error("Camera access error:", err);
                errorMsg.classList.remove('hidden');
                errorMsg.innerText = "Gagal mengakses kamera: " + (err.message || "Pastikan Anda memberikan izin akses kamera pada browser.");
                statusEl.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-red-600"></span> Akses Kamera Ditolak';
            }
        }

        // Capture a single frame from video element
        function captureFrame() {
            const videoEl = document.getElementById('webcam-video');
            const canvas = document.getElementById('capture-canvas');
            const ctx = canvas.getContext('2d');

            canvas.width = videoEl.videoWidth || 640;
            canvas.height = videoEl.videoHeight || 480;

            // Flip horizontally to mirror selfie camera naturally
            ctx.translate(canvas.width, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(videoEl, 0, 0, canvas.width, canvas.height);

            // Flash effect animation
            const flash = document.getElementById('flash-element');
            flash.classList.add('do-flash');
            setTimeout(() => flash.classList.remove('do-flash'), 400);

            return canvas.toDataURL('image/jpeg', 0.95);
        }

        // Automated 4-photo capture session
        async function startAutoSession() {
            if (APP_STATE.isCapturingSession) return;
            APP_STATE.isCapturingSession = true;

            const btnStart = document.getElementById('btn-start-session');
            btnStart.disabled = true;

            for (let i = 0; i < 4; i++) {
                // If photo slot already filled (e.g., retaking individual photo), skip unless missing
                await runCountdown(3);
                const photoData = captureFrame();
                setPhotoSlot(i, photoData);
            }

            APP_STATE.isCapturingSession = false;
            checkPhotoCompletion();
        }

        // Individual Photo Retake Trigger
        async function retakeSinglePhoto(index) {
            if (APP_STATE.isCapturingSession) return;
            APP_STATE.isCapturingSession = true;

            await runCountdown(3);
            const photoData = captureFrame();
            setPhotoSlot(index, photoData);

            APP_STATE.isCapturingSession = false;
            checkPhotoCompletion();
        }

        function runCountdown(seconds) {
            return new Promise((resolve) => {
                const overlay = document.getElementById('countdown-overlay');
                const numEl = document.getElementById('countdown-number');
                overlay.classList.remove('hidden');

                let count = seconds;
                numEl.innerText = count;

                const timer = setInterval(() => {
                    count--;
                    if (count > 0) {
                        numEl.innerText = count;
                    } else {
                        clearInterval(timer);
                        overlay.classList.add('hidden');
                        resolve();
                    }
                }, 1000);
            });
        }

        function setPhotoSlot(index, base64Data) {
            APP_STATE.capturedPhotos[index] = base64Data;

            const thumb = document.getElementById(`thumb-${index}`);
            const emptyTxt = document.getElementById(`empty-thumb-${index}`);
            const retakeBtn = document.getElementById(`btn-retake-${index}`);

            thumb.src = base64Data;
            thumb.classList.remove('hidden');
            emptyTxt.classList.add('hidden');
            retakeBtn.disabled = false;

            // Update badge progress
            const filledCount = APP_STATE.capturedPhotos.filter(Boolean).length;
            document.getElementById('photo-progress-badge').innerText = `Progress: ${filledCount} / 4`;
        }

        function resetAllPhotos() {
            APP_STATE.capturedPhotos = [null, null, null, null];
            for (let i = 0; i < 4; i++) {
                const thumb = document.getElementById(`thumb-${i}`);
                const emptyTxt = document.getElementById(`empty-thumb-${i}`);
                const retakeBtn = document.getElementById(`btn-retake-${i}`);

                thumb.src = "";
                thumb.classList.add('hidden');
                emptyTxt.classList.remove('hidden');
                retakeBtn.disabled = true;
            }
            document.getElementById('photo-progress-badge').innerText = `Progress: 0 / 4`;
            checkPhotoCompletion();
        }

        function checkPhotoCompletion() {
            const filledCount = APP_STATE.capturedPhotos.filter(Boolean).length;
            const btnToFilter = document.getElementById('btn-to-filter');
            if (filledCount === 4) {
                btnToFilter.disabled = false;
                btnToFilter.classList.remove('opacity-50', 'cursor-not-allowed');
            } else {
                btnToFilter.disabled = true;
                btnToFilter.classList.add('opacity-50', 'cursor-not-allowed');
            }
        }


        // ================= FILTER MODULE =================
        function applyFilter(filterType) {
            APP_STATE.selectedFilter = filterType;

            const filterClasses = {
                newspaper: 'filter-newspaper',
                bw: 'filter-bw',
                sepia: 'filter-sepia',
                warm: 'filter-warm',
                contrast: 'filter-contrast',
                soft: 'filter-soft',
                original: 'filter-original'
            };

            // Update previews
            for (let i = 0; i < 4; i++) {
                const img = document.getElementById(`filter-preview-${i}`);
                if (img && APP_STATE.capturedPhotos[i]) {
                    img.src = APP_STATE.capturedPhotos[i];
                    img.className = `w-full h-full object-cover ${filterClasses[filterType] || ''}`;
                }
            }

            // Update active state styling on filter buttons
            const filterKeys = ['newspaper', 'bw', 'sepia', 'warm', 'contrast', 'soft', 'original'];
            filterKeys.forEach(k => {
                const btn = document.getElementById(`btn-filter-${k}`);
                if (btn) {
                    if (k === filterType) {
                        btn.className = "p-3 border-2 border-ink rounded bg-ink text-parchment font-bold text-center";
                    } else {
                        btn.className = "p-3 border-2 border-ink/40 rounded hover:border-ink text-center";
                    }
                }
            });
        }

        function generatePosterAndNavigate() {
            renderPosterCanvas();
            navigateTo('page-poster');
        }


        // ================= HIGH-RES A4 CANVAS POSTER RENDERER =================
        function renderPosterCanvas() {
            const canvas = document.getElementById('poster-canvas');
            const ctx = canvas.getContext('2d');

            // Set high resolution target: A4 @ 300 DPI approx (2480 x 3508 px)
            const W = 2480;
            const H = 3508;
            canvas.width = W;
            canvas.height = H;

            // 1. Fill Parchment Vintage Background
            ctx.fillStyle = '#f4ebd0';
            ctx.fillRect(0, 0, W, H);

            // Vintage Subtle Paper Texture via canvas noise overlay
            ctx.fillStyle = 'rgba(112, 66, 20, 0.03)';
            for (let i = 0; i < 50000; i++) {
                const rx = Math.random() * W;
                const ry = Math.random() * H;
                ctx.fillRect(rx, ry, 3, 3);
            }

            // 2. Outer Border Frame
            ctx.strokeStyle = '#1a1412';
            ctx.lineWidth = 18;
            ctx.strokeRect(60, 60, W - 120, H - 120);

            ctx.lineWidth = 6;
            ctx.strokeRect(85, 85, W - 170, H - 170);

            // 3. HEADER TEXT SECTION
            ctx.fillStyle = '#1a1412';
            ctx.textAlign = 'center';

            // Top Small Header
            ctx.font = 'bold 42px "Courier Prime", monospace';
            ctx.fillText('PPG CALON GURU GELOMBANG 2 TAHUN 2026', W / 2, 170);

            // Double Horizontal Line
            drawDoubleLine(ctx, 110, 205, W - 220);

            // Subheader Title
            ctx.font = '800 68px "Playfair Display", serif';
            ctx.fillText('GELAR KARYA KELOMPOK B PPKn', W / 2, 290);

            drawDoubleLine(ctx, 110, 320, W - 220);

            // Huge WANTED Title
            ctx.font = '900 240px "Playfair Display", serif';
            ctx.fillText('WANTED', W / 2, 540);

            // Decorative Sub-Text
            ctx.font = 'bold 46px "Courier Prime", monospace';
            ctx.fillText('DEAD OR ALIVE - DOKUMENTASI KEGIATAN', W / 2, 620);

            drawDoubleLine(ctx, 110, 650, W - 220);

            // 4. 2x2 GRID PHOTOS RENDERING
            const gridX = 180;
            const gridY = 720;
            const gridWidth = W - 360; // 2120 px
            const photoW = 1000;
            const photoH = 750;
            const gapX = 120;
            const gapY = 80;

            const loadedImages = [];
            let imagesProcessed = 0;

            for (let i = 0; i < 4; i++) {
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.src = APP_STATE.capturedPhotos[i] || 'https://placehold.co/800x600/f4ebd0/1a1412?text=FOTO';
                
                img.onload = () => {
                    loadedImages[i] = img;
                    imagesProcessed++;
                    if (imagesProcessed === 4) {
                        drawAllGridPhotos();
                    }
                };
            }

            function drawAllGridPhotos() {
                for (let i = 0; i < 4; i++) {
                    const col = i % 2;
                    const row = Math.floor(i / 2);

                    const x = gridX + col * (photoW + gapX);
                    const y = gridY + row * (photoH + gapY);

                    // Photo Vintage Border Frame
                    ctx.fillStyle = '#e6d7b2';
                    ctx.fillRect(x - 15, y - 15, photoW + 30, photoH + 30);
                    ctx.strokeStyle = '#1a1412';
                    ctx.lineWidth = 10;
                    ctx.strokeRect(x - 15, y - 15, photoW + 30, photoH + 30);

                    // Draw Image with applied canvas CSS filter emulation
                    ctx.save();
                    ctx.beginPath();
                    ctx.rect(x, y, photoW, photoH);
                    ctx.clip();

                    // Apply Selected Color Filter
                    applyCanvasFilter(ctx, APP_STATE.selectedFilter);

                    ctx.drawImage(loadedImages[i], x, y, photoW, photoH);
                    ctx.restore();

                    // Photo Slot Label
                    ctx.fillStyle = '#1a1412';
                    ctx.font = 'bold 36px "Courier Prime", monospace';
                    ctx.fillText(`[ BUKTI BUKTI #${i + 1} ]`, x + photoW / 2, y + photoH + 50);
                }

                // 5. FOOTER DECORATIVE SECTION
                const footerY = 2420;
                drawDoubleLine(ctx, 110, footerY, W - 220);

                ctx.font = 'italic 48px "Playfair Display", serif';
                ctx.fillText('“Terus Berkarya Membangun Bangsa Melalui Pendidikan Pancasila & Kewarganegaraan”', W / 2, footerY + 90);

                // Reward & Details Box
                ctx.strokeStyle = '#1a1412';
                ctx.lineWidth = 8;
                ctx.strokeRect(200, footerY + 160, W - 400, 500);

                ctx.font = '900 110px "Playfair Display", serif';
                ctx.fillText('REWARD: DOKUMENTASI TERBAIK', W / 2, footerY + 290);

                ctx.font = '40px "Courier Prime", monospace';
                ctx.fillText('LOKASI: GELAR KARYA PPG CALON GURU GELOMBANG 2', W / 2, footerY + 380);
                ctx.fillText('TANGGAL: ACARA RESMI KELOMPOK B PPKn 2026', W / 2, footerY + 440);

                // Official Stamp Graphic
                ctx.save();
                ctx.translate(W - 450, footerY + 380);
                ctx.rotate(-15 * Math.PI / 180);
                ctx.strokeStyle = '#8b0000';
                ctx.fillStyle = '#8b0000';
                ctx.lineWidth = 12;
                ctx.strokeRect(-160, -60, 320, 120);
                ctx.font = 'bold 50px "Courier Prime", monospace';
                ctx.fillText('TERVERIFIKASI', 0, 15);
                ctx.restore();
            }
        }

        function drawDoubleLine(ctx, x, y, width) {
            ctx.strokeStyle = '#1a1412';
            ctx.lineWidth = 12;
            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.lineTo(x + width, y);
            ctx.stroke();

            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(x, y + 18);
            ctx.lineTo(x + width, y + 18);
            ctx.stroke();
        }

        function applyCanvasFilter(ctx, filter) {
            switch (filter) {
                case 'bw':
                    ctx.filter = 'grayscale(100%) contrast(130%)';
                    break;
                case 'sepia':
                    ctx.filter = 'sepia(100%) contrast(110%) brightness(95%)';
                    break;
                case 'newspaper':
                    ctx.filter = 'grayscale(100%) contrast(180%) brightness(90%)';
                    break;
                case 'warm':
                    ctx.filter = 'sepia(40%) saturate(140%) hue-rotate(-10deg)';
                    break;
                case 'contrast':
                    ctx.filter = 'contrast(160%) brightness(95%)';
                    break;
                case 'soft':
                    ctx.filter = 'sepia(20%) brightness(105%) contrast(90%)';
                    break;
                default:
                    ctx.filter = 'none';
                    break;
            }
        }


        // ================= EXPORT & PRINT MODULE =================
        function downloadPoster(format) {
            const canvas = document.getElementById('poster-canvas');
            const mimeType = format === 'jpg' ? 'image/jpeg' : 'image/png';
            const fileName = `Poster_WANTED_PPKn_GroupB_${Date.now()}.${format}`;

            const link = document.createElement('a');
            link.download = fileName;
            link.href = canvas.toDataURL(mimeType, 0.95);
            link.click();
        }

        function printPoster() {
            const canvas = document.getElementById('poster-canvas');
            const dataUrl = canvas.toDataURL('image/png');

            const printWin = window.open('', '_blank');
            printWin.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Cetak Poster A4 WANTED</title>
                    <style>
                        @page { size: A4 portrait; margin: 0; }
                        body { margin: 0; display: flex; justify-content: center; align-items: center; background: #fff; }
                        img { width: 100vw; height: 100vh; object-fit: contain; }
                    </style>
                </head>
                <body>
                    <img src="${dataUrl}" onload="window.print(); window.close();" />
                </body>
                </html>
            `);
            printWin.document.close();
        }


        // ================= PAYMENT SYSTEM MODULE =================
        function switchPaymentTab(type) {
            const btnQris = document.getElementById('tab-btn-qris');
            const btnCash = document.getElementById('tab-btn-cash');
            const boxQris = document.getElementById('payment-box-qris');
            const boxCash = document.getElementById('payment-box-cash');

            if (type === 'qris') {
                btnQris.className = "py-3 border-2 border-ink bg-ink text-parchment text-center rounded";
                btnCash.className = "py-3 border-2 border-ink bg-transparent text-ink text-center rounded";
                boxQris.classList.remove('hidden');
                boxCash.classList.add('hidden');
            } else {
                btnCash.className = "py-3 border-2 border-ink bg-ink text-parchment text-center rounded";
                btnQris.className = "py-3 border-2 border-ink bg-transparent text-ink text-center rounded";
                boxCash.classList.remove('hidden');
                boxQris.classList.add('hidden');
            }
        }

        function confirmPayment(method) {
            const confirmMsg = method === 'CASH' 
                ? "Apakah kamu yakin ingin mengonfirmasi pembayaran tunai kepada petugas?"
                : "Apakah kamu yakin telah memindai dan menyelesaikan pembayaran QRIS?";

            if (confirm(confirmMsg)) {
                const txId = "#PPG-2026-" + Math.floor(1000 + Math.random() * 9000);
                const now = new Date().toLocaleString('id-ID');

                document.getElementById('summary-tx-id').innerText = txId;
                document.getElementById('summary-method').innerText = method === 'CASH' ? 'Cash / Tunai' : 'QRIS Resmi';
                document.getElementById('summary-status').innerText = 'Konfirmasi Diterima';
                document.getElementById('summary-time').innerText = now;

                // Send data to optional Google Apps Script Web App Endpoint if configured
                if (APP_STATE.gasWebhookUrl) {
                    try {
                        fetch(APP_STATE.gasWebhookUrl, {
                            method: 'POST',
                            mode: 'no-cors',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                txId: txId,
                                timestamp: now,
                                method: method,
                                amount: APP_STATE.priceAmount,
                                status: 'Konfirmasi Diterima'
                            })
                        });
                    } catch (e) {
                        console.log("GAS Log optional notify failed", e);
                    }
                }

                navigateTo('page-summary');
            }
        }

        function resetWholeSession() {
            resetAllPhotos();
            navigateTo('page-home');
        }


        // ================= ADMIN & CONFIG MODULE =================
        function openAdminModal() {
            document.getElementById('admin-modal').classList.remove('hidden');
            document.getElementById('admin-lock-screen').classList.remove('hidden');
            document.getElementById('admin-settings-screen').classList.add('hidden');
            document.getElementById('admin-pin-input').value = "";
        }

        function closeAdminModal() {
            document.getElementById('admin-modal').classList.add('hidden');
        }

        function verifyAdminPin() {
            const pin = document.getElementById('admin-pin-input').value;
            if (pin === "1234" || pin === "2026") {
                document.getElementById('admin-lock-screen').classList.add('hidden');
                document.getElementById('admin-settings-screen').classList.remove('hidden');
                
                // populate current values
                document.getElementById('admin-price-input').value = APP_STATE.priceAmount;
                document.getElementById('admin-qris-url').value = APP_STATE.qrisImageSrc;
                document.getElementById('admin-gas-url').value = APP_STATE.gasWebhookUrl;
            } else {
                alert("PIN Admin salah! (Default PIN: 1234)");
            }
        }

        function handleQrisFileUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('admin-qris-url').value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        function saveAdminSettings() {
            const newPrice = parseInt(document.getElementById('admin-price-input').value) || 10000;
            const newQris = document.getElementById('admin-qris-url').value;
            const newGas = document.getElementById('admin-gas-url').value;

            APP_STATE.priceAmount = newPrice;
            APP_STATE.qrisImageSrc = newQris;
            APP_STATE.gasWebhookUrl = newGas;

            // Update UI elements
            document.getElementById('display-payment-amount').innerText = `Rp ${newPrice.toLocaleString('id-ID')}`;
            document.getElementById('qris-image').src = newQris;

            alert("Konfigurasi admin berhasil disimpan!");
            closeAdminModal();
        }
    </script>
</body>
