<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photobooth Vintage - Gelar Karya Kelompok B PPKn</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts for Vintage Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;0,900;1,400&family=Special+Elite&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- HTML5 Canvas Utilities / Konva/html2canvas optionally loaded if needed, using native Canvas API for crisp high-res output -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        parchment: '#f4ebd0',
                        'parchment-dark': '#e6d7b2',
                        ink: '#1a1412',
                        'ink-light': '#362a26',
                        sepia: '#704214',
                        wood: '#2b1e17',
                        crimson: '#8b0000'
                    },
                    fontFamily: {
                        headline: ['Playfair Display', 'serif'],
                        typewriter: ['Special Elite', 'monospace'],
                        body: ['Courier Prime', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Vintage Styles */
        body {
            background-color: #2b1e17;
            background-image: radial-gradient(#3a291f 1px, transparent 0);
            background-size: 24px 24px;
            color: #1a1412;
            font-family: 'Courier Prime', monospace;
        }

        .paper-texture {
            background-color: #f4ebd0;
            background-image: 
                radial-gradient(hsla(30, 20%, 30%, 0.05) 1px, transparent 0),
                linear-gradient(to bottom, rgba(255,255,255,0.2), rgba(0,0,0,0.05));
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 100px rgba(112, 66, 20, 0.15);
            border: 2px solid #1a1412;
        }

        .vintage-border {
            border: 4px double #1a1412;
            outline: 1px solid #1a1412;
            outline-offset: 3px;
        }

        .newspaper-line {
            border-bottom: 2px solid #1a1412;
            border-top: 1px solid #1a1412;
            height: 4px;
            margin: 8px 0;
        }

        .btn-vintage {
            background: #1a1412;
            color: #f4ebd0;
            border: 2px solid #1a1412;
            font-family: 'Playfair Display', serif;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s ease;
            box-shadow: 3px 3px 0px rgba(112, 66, 20, 0.4);
        }

        .btn-vintage:hover:not(:disabled) {
            background: #704214;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 5px 5px 0px rgba(0, 0, 0, 0.6);
        }

        .btn-vintage:active:not(:disabled) {
            transform: translateY(0);
            box-shadow: 1px 1px 0px #000;
        }

        .btn-vintage-outline {
            background: transparent;
            color: #1a1412;
            border: 2px solid #1a1412;
            font-family: 'Playfair Display', serif;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s ease;
        }

        .btn-vintage-outline:hover:not(:disabled) {
            background: #1a1412;
            color: #f4ebd0;
        }

        /* Flash Animation */
        @keyframes cameraFlash {
            0% { opacity: 1; background-color: white; }
            100% { opacity: 0; background-color: transparent; }
        }
        .flash-overlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 50;
        }
        .do-flash {
            animation: cameraFlash 0.4s ease-out;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #e6d7b2;
        }
        ::-webkit-scrollbar-thumb {
            background: #1a1412;
            border-radius: 4px;
        }

        /* CSS Filters preview styles */
        .filter-original { filter: none; }
        .filter-bw { filter: grayscale(100%) contrast(120%); }
        .filter-sepia { filter: sepia(100%) contrast(105%) brightness(95%); }
        .filter-newspaper { filter: grayscale(100%) contrast(180%) brightness(90%); }
        .filter-warm { filter: sepia(40%) saturate(140%) hue-rotate(-10deg); }
        .filter-contrast { filter: contrast(150%) brightness(95%); }
        .filter-soft { filter: sepia(20%) brightness(105%) contrast(90%); }
    </style>
</head>
<body class="min-h-screen py-6 px-3 sm:px-6 flex flex-col justify-between items-center">

    <!-- TOP STEPPER NAVIGATION HEADER -->
    <header class="w-full max-w-4xl mb-6">
        <div class="paper-texture p-4 rounded-sm border-2 border-ink text-center">
            <div class="text-xs sm:text-sm font-bold tracking-widest uppercase border-b border-ink pb-1 mb-2">
                PPG CALON GURU GELOMBANG 2 TAHUN 2026
            </div>
            <h1 class="text-xl sm:text-3xl font-black font-headline tracking-wide uppercase">
                Gelar Karya Kelompok B PPKn
            </h1>
            
            <!-- Process Flow Tracker -->
            <div class="mt-4 pt-3 border-t border-ink/40 flex justify-center items-center gap-1 sm:gap-4 text-xs font-typewriter overflow-x-auto">
                <span id="step-nav-1" class="px-2 py-1 bg-ink text-parchment font-bold rounded">1. AWAL</span>
                <i data-lucide="chevron-right" class="w-3 h-3 text-ink/60"></i>
                <span id="step-nav-2" class="px-2 py-1 text-ink/60">2. KAMERA</span>
                <i data-lucide="chevron-right" class="w-3 h-3 text-ink/60"></i>
                <span id="step-nav-3" class="px-2 py-1 text-ink/60">3. FILTER</span>
                <i data-lucide="chevron-right" class="w-3 h-3 text-ink/60"></i>
                <span id="step-nav-4" class="px-2 py-1 text-ink/60">4. POSTER</span>
                <i data-lucide="chevron-right" class="w-3 h-3 text-ink/60"></i>
                <span id="step-nav-5" class="px-2 py-1 text-ink/60">5. BAYAR</span>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="w-full max-w-4xl flex-grow flex flex-col justify-center">

        <!-- ================= PAGE 1: HOME / LANDING ================= -->
        <section id="page-home" class="paper-texture p-6 sm:p-10 rounded-sm vintage-border text-center flex flex-col items-center">
            <div class="newspaper-line w-full"></div>
            <p class="text-xs sm:text-sm uppercase font-typewriter tracking-widest my-1">Edisi Khusus Dokumentasi PPG</p>
            <div class="newspaper-line w-full"></div>

            <div class="my-6 relative">
                <!-- Vintage Camera SVG Icon -->
                <div class="w-28 h-28 sm:w-36 sm:h-36 mx-auto bg-ink/5 p-4 rounded-full border-2 border-dashed border-ink flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#1a1412" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-20 h-20 sm:w-24 sm:h-24">
                        <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                        <circle cx="12" cy="13" r="3"/>
                        <line x1="12" y1="10" x2="12" y2="10.01"/>
                    </svg>
                </div>
            </div>

            <h2 class="text-4xl sm:text-6xl font-black font-headline tracking-tighter text-ink mb-2">
                WANTED
            </h2>
            <p class="font-typewriter text-sm sm:text-base max-w-lg mb-6 text-ink/80">
                Abadikan momen Gelar Karya Kelompok B PPKn dalam lembaran poster koran vintage klasik ukuran A4!
            </p>

            <div class="bg-parchment-dark/60 p-4 border border-ink/40 rounded max-w-md w-full mb-8 text-left text-xs sm:text-sm space-y-2 font-body">
                <div class="font-bold border-b border-ink/20 pb-1 text-center font-headline uppercase text-base">Petunjuk Pengambilan Foto</div>
                <div class="flex items-start gap-2">
                    <span class="font-bold font-typewriter bg-ink text-parchment px-1.5 py-0.5 text-xs rounded">1</span>
                    <span>Aktifkan izin kamera browser pada HP atau Laptop Anda.</span>
                </div>
                <div class="flex items-start gap-2">
                    <span class="font-bold font-typewriter bg-ink text-parchment px-1.5 py-0.5 text-xs rounded">2</span>
                    <span>Sistem akan mengambil <strong>4 foto berturut-turut</strong> dengan jeda hitung mundur 3 detik.</span>
                </div>
                <div class="flex items-start gap-2">
                    <span class="font-bold font-typewriter bg-ink text-parchment px-1.5 py-0.5 text-xs rounded">3</span>
                    <span>Anda dapat mengulang foto tertentu jika hasilnya belum pas.</span>
                </div>
                <div class="flex items-start gap-2">
                    <span class="font-bold font-typewriter bg-ink text-parchment px-1.5 py-0.5 text-xs rounded">4</span>
                    <span>Pilih filter vintage, ekspor poster A4, dan selesaikan pembayaran.</span>
                </div>
            </div>

            <button id="btn-start-photobooth" onclick="navigateTo('page-camera')" class="btn-vintage px-8 py-4 text-lg sm:text-xl rounded flex items-center gap-3">
                <i data-lucide="camera" class="w-6 h-6"></i>
                MULAI PHOTOBOOTH
            </button>
        </section>


        <!-- ================= PAGE 2: CAMERA SESSION ================= -->
        <section id="page-camera" class="paper-texture p-4 sm:p-6 rounded-sm vintage-border hidden">
            <div class="flex flex-col md:flex-row gap-6">
                
                <!-- Live Camera View Box -->
                <div class="flex-1 flex flex-col items-center">
                    <div class="w-full flex justify-between items-center mb-2 font-typewriter text-xs sm:text-sm">
                        <span id="camera-status" class="font-bold text-crimson flex items-center gap-1">
                            <span class="w-2.5 h-2.5 rounded-full bg-crimson animate-pulse"></span> Kamera Mati
                        </span>
                        <span id="photo-progress-badge" class="bg-ink text-parchment px-2 py-0.5 rounded font-bold">Progress: 0 / 4</span>
                    </div>

                    <!-- Video / Canvas Viewport -->
                    <div class="relative w-full aspect-[4/3] bg-black border-4 border-ink rounded overflow-hidden shadow-inner flex items-center justify-center">
                        <video id="webcam-video" autoplay playsinline class="w-full h-full object-cover transform -scale-x-100"></video>
                        <canvas id="capture-canvas" class="hidden"></canvas>
                        
                        <!-- Flash effect overlay -->
                        <div id="flash-element" class="flash-overlay"></div>

                        <!-- Countdown Overlay -->
                        <div id="countdown-overlay" class="absolute inset-0 bg-ink/40 backdrop-blur-xs flex items-center justify-center hidden">
                            <span id="countdown-number" class="text-7xl sm:text-9xl font-black font-headline text-parchment drop-shadow-lg animate-ping">3</span>
                        </div>

                        <!-- Camera Placeholder Before Activation -->
                        <div id="camera-placeholder" class="absolute inset-0 bg-ink/90 flex flex-col items-center justify-center text-parchment p-4 text-center">
                            <i data-lucide="camera-off" class="w-12 h-12 mb-3 text-parchment/60"></i>
                            <p class="font-typewriter text-sm mb-4">Kamera belum diaktifkan.</p>
                            <button id="btn-enable-camera" onclick="initCamera()" class="btn-vintage bg-parchment text-ink px-4 py-2 rounded text-sm hover:bg-parchment-dark">
                                Aktifkan Kamera
                            </button>
                        </div>
                    </div>

                    <!-- Camera Control Buttons -->
                    <div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
                        <button id="btn-start-session" onclick="startAutoSession()" disabled class="btn-vintage py-3 px-4 rounded text-center flex items-center justify-center gap-2 opacity-50 cursor-not-allowed">
                            <i data-lucide="play-circle" class="w-5 h-5"></i>
                            MULAI FOTO (4 SEKALIGUS)
                        </button>
                        <button id="btn-retake-all" onclick="resetAllPhotos()" class="btn-vintage-outline py-3 px-4 rounded text-center flex items-center justify-center gap-2">
                            <i data-lucide="rotate-ccw" class="w-5 h-5"></i>
                            ULANGI SEMUA FOTO
                        </button>
                    </div>

                    <div id="camera-error-msg" class="w-full mt-3 p-3 bg-red-100 border border-red-400 text-red-800 text-xs rounded hidden"></div>
                </div>

                <!-- Captured Photos 2x2 Thumbnail Sidebar -->
                <div class="w-full md:w-72 flex flex-col justify-between border-t md:border-t-0 md:border-l border-ink/30 pt-4 md:pt-0 md:pl-6">
                    <div>
                        <h3 class="font-headline font-bold text-lg mb-2 text-center md:text-left border-b border-ink/30 pb-1">HASIL TANGKAPAN</h3>
                        <p class="text-xs font-typewriter text-ink/70 mb-3">Klik tombol "Ulangi" pada foto tertentu jika ingin mengambil ulang foto tersebut.</p>

                        <div class="grid grid-cols-2 gap-2">
                            <!-- Slot 1 -->
                            <div class="border-2 border-ink bg-parchment-dark p-1 rounded relative group">
                                <div class="aspect-[4/3] bg-ink/10 overflow-hidden flex items-center justify-center relative">
                                    <img id="thumb-0" class="w-full h-full object-cover hidden" />
                                    <span id="empty-thumb-0" class="text-xs font-typewriter text-ink/40">Foto 1</span>
                                </div>
                                <button onclick="retakeSinglePhoto(0)" id="btn-retake-0" disabled class="w-full mt-1 py-1 text-[10px] bg-ink text-parchment font-typewriter disabled:opacity-40 rounded">
                                    Ulangi #1
                                </button>
                            </div>
                            <!-- Slot 2 -->
                            <div class="border-2 border-ink bg-parchment-dark p-1 rounded relative group">
                                <div class="aspect-[4/3] bg-ink/10 overflow-hidden flex items-center justify-center relative">
                                    <img id="thumb-1" class="w-full h-full object-cover hidden" />
                                    <span id="empty-thumb-1" class="text-xs font-typewriter text-ink/40">Foto 2</span>
                                </div>
                                <button onclick="retakeSinglePhoto(1)" id="btn-retake-1" disabled class="w-full mt-1 py-1 text-[10px] bg-ink text-parchment font-typewriter disabled:opacity-40 rounded">
                                    Ulangi #2
                                </button>
                            </div>
                            <!-- Slot 3 -->
                            <div class="border-2 border-ink bg-parchment-dark p-1 rounded relative group">
                                <div class="aspect-[4/3] bg-ink/10 overflow-hidden flex items-center justify-center relative">
                                    <img id="thumb-2" class="w-full h-full object-cover hidden" />
                                    <span id="empty-thumb-2" class="text-xs font-typewriter text-ink/40">Foto 3</span>
                                </div>
                                <button onclick="retakeSinglePhoto(2)" id="btn-retake-2" disabled class="w-full mt-1 py-1 text-[10px] bg-ink text-parchment font-typewriter disabled:opacity-40 rounded">
                                    Ulangi #3
                                </button>
                            </div>
                            <!-- Slot 4 -->
                            <div class="border-2 border-ink bg-parchment-dark p-1 rounded relative group">
                                <div class="aspect-[4/3] bg-ink/10 overflow-hidden flex items-center justify-center relative">
                                    <img id="thumb-3" class="w-full h-full object-cover hidden" />
                                    <span id="empty-thumb-3" class="text-xs font-typewriter text-ink/40">Foto 4</span>
                                </div>
                                <button onclick="retakeSinglePhoto(3)" id="btn-retake-3" disabled class="w-full mt-1 py-1 text-[10px] bg-ink text-parchment font-typewriter disabled:opacity-40 rounded">
                                    Ulangi #4
                                </button>
                            </div>
                        </div>
                    </div>

                    <button id="btn-to-filter" onclick="navigateTo('page-filter')" disabled class="btn-vintage w-full py-3 mt-6 rounded flex items-center justify-center gap-2 opacity-50 cursor-not-allowed">
                        LANJUT KE FILTER
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
        </section>


        <!-- ================= PAGE 3: FILTER SELECTION ================= -->
        <section id="page-filter" class="paper-texture p-4 sm:p-6 rounded-sm vintage-border hidden">
            <h2 class="text-2xl sm:text-3xl font-black font-headline text-center uppercase mb-1">Pilih Filter Vintage</h2>
            <p class="text-center font-typewriter text-xs sm:text-sm text-ink/80 mb-6">Sesuaikan efek warna untuk memberikan sentuhan koran atau poster kuno.</p>

            <!-- Grid Previews of 4 Photos with selected filter -->
            <div class="max-w-md mx-auto grid grid-cols-2 gap-3 mb-6 p-3 bg-parchment-dark/50 border border-ink/40 rounded">
                <div class="aspect-[4/3] border border-ink overflow-hidden bg-black">
                    <img id="filter-preview-0" class="w-full h-full object-cover filter-newspaper" />
                </div>
                <div class="aspect-[4/3] border border-ink overflow-hidden bg-black">
                    <img id="filter-preview-1" class="w-full h-full object-cover filter-newspaper" />
                </div>
                <div class="aspect-[4/3] border border-ink overflow-hidden bg-black">
                    <img id="filter-preview-2" class="w-full h-full object-cover filter-newspaper" />
                </div>
                <div class="aspect-[4/3] border border-ink overflow-hidden bg-black">
                    <img id="filter-preview-3" class="w-full h-full object-cover filter-newspaper" />
                </div>
            </div>

            <!-- Filter Buttons Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8 max-w-2xl mx-auto font-typewriter text-xs">
                <button onclick="applyFilter('newspaper')" id="btn-filter-newspaper" class="p-3 border-2 border-ink rounded bg-ink text-parchment font-bold text-center">
                    📰 Vintage Newspaper
                </button>
                <button onclick="applyFilter('bw')" id="btn-filter-bw" class="p-3 border-2 border-ink/40 rounded hover:border-ink text-center">
                    🖤 Black & White
                </button>
                <button onclick="applyFilter('sepia')" id="btn-filter-sepia" class="p-3 border-2 border-ink/40 rounded hover:border-ink text-center">
                    📜 Sepia Classic
                </button>
                <button onclick="applyFilter('warm')" id="btn-filter-warm" class="p-3 border-2 border-ink/40 rounded hover:border-ink text-center">
                    ☀️ Retro Warm
                </button>
                <button onclick="applyFilter('contrast')" id="btn-filter-contrast" class="p-3 border-2 border-ink/40 rounded hover:border-ink text-center">
                    🔲 High Contrast
                </button>
                <button onclick="applyFilter('soft')" id="btn-filter-soft" class="p-3 border-2 border-ink/40 rounded hover:border-ink text-center">
                    📜 Soft Vintage
                </button>
                <button onclick="applyFilter('original')" id="btn-filter-original" class="p-3 border-2 border-ink/40 rounded hover:border-ink text-center">
                    📷 Original Color
                </button>
            </div>

            <!-- Action Navigation -->
            <div class="flex flex-col sm:flex-row justify-between gap-3 max-w-2xl mx-auto border-t border-ink/30 pt-4">
                <button onclick="navigateTo('page-camera')" class="btn-vintage-outline py-3 px-6 rounded flex items-center justify-center gap-2">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Kembali ke Foto
                </button>
                <button onclick="generatePosterAndNavigate()" class="btn-vintage py-3 px-6 rounded flex items-center justify-center gap-2">
                    Lanjut ke Poster
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </div>
        </section>


        <!-- ================= PAGE 4: POSTER PREVIEW & DOWNLOAD ================= -->
        <section id="page-poster" class="paper-texture p-4 sm:p-6 rounded-sm vintage-border hidden">
            <h2 class="text-2xl sm:text-3xl font-black font-headline text-center uppercase mb-1">Pratinjau Poster A4</h2>
            <p class="text-center font-typewriter text-xs sm:text-sm text-ink/80 mb-6">Poster koran vintage resolusi tinggi (2480 × 3508 px) siap unduh / cetak.</p>

            <div class="flex flex-col lg:flex-row gap-6 items-center lg:items-start justify-center">
                
                <!-- High-Res Generated Poster Canvas Preview -->
                <div class="w-full max-w-sm sm:max-w-md aspect-[1/1.414] border-4 border-ink shadow-2xl bg-parchment p-1 relative flex items-center justify-center overflow-hidden">
                    <canvas id="poster-canvas" class="w-full h-full object-contain"></canvas>
                </div>

                <!-- Poster Actions Side Menu -->
                <div class="w-full lg:w-80 flex flex-col gap-3 font-typewriter">
                    <div class="bg-parchment-dark p-4 border border-ink/40 rounded text-xs space-y-2">
                        <div class="font-bold font-headline text-sm uppercase text-ink border-b border-ink/30 pb-1">Spesifikasi Poster</div>
                        <p><strong>Ukuran Standard:</strong> ISO A4 Portrait (210 x 297 mm)</p>
                        <p><strong>Resolusi Ekspor:</strong> High-DPI (2480 x 3508 px)</p>
                        <p><strong>Format:</strong> PNG / JPG Siap Cetak</p>
                    </div>

                    <button onclick="downloadPoster('png')" class="btn-vintage py-3 px-4 rounded flex items-center justify-center gap-2 text-sm">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        UNDUH POSTER PNG
                    </button>
                    <button onclick="downloadPoster('jpg')" class="btn-vintage-outline py-3 px-4 rounded flex items-center justify-center gap-2 text-sm">
                        <i data-lucide="file-image" class="w-4 h-4"></i>
                        UNDUH POSTER JPG
                    </button>
                    <button onclick="printPoster()" class="btn-vintage-outline py-3 px-4 rounded flex items-center justify-center gap-2 text-sm">
                        <i data-lucide="printer" class="w-4 h-4"></i>
                        CETAK POSTER
                    </button>

                    <div class="newspaper-line my-1"></div>

                    <button onclick="navigateTo('page-payment')" class="btn-vintage bg-crimson hover:bg-red-900 text-white py-3 px-4 rounded flex items-center justify-center gap-2 text-sm">
                        LANJUT KE PEMBAYARAN
                        <i data-lucide="credit-card" class="w-4 h-4"></i>
                    </button>
                    
                    <button onclick="navigateTo('page-filter')" class="btn-vintage-outline py-2 px-4 rounded text-xs flex items-center justify-center gap-2">
                        <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
                        Ganti Filter
                    </button>
                </div>
            </div>
        </section>


        <!-- ================= PAGE 5: PAYMENT METHOD ================= -->
        <section id="page-payment" class="paper-texture p-4 sm:p-8 rounded-sm vintage-border hidden max-w-2xl mx-auto w-full">
            <h2 class="text-3xl font-black font-headline text-center uppercase mb-1">SELESAIKAN PEMBAYARAN</h2>
            <p class="text-center font-typewriter text-xs sm:text-sm text-ink/80 mb-6">Pilih salah satu metode pembayaran sederhana di bawah ini.</p>

            <!-- Price Summary Banner -->
            <div class="bg-parchment-dark p-3 border-2 border-ink text-center mb-6 rounded">
                <span class="font-typewriter text-xs uppercase block">Biaya Cetak & File Dokumentasi:</span>
                <span id="display-payment-amount" class="font-headline font-black text-2xl text-crimson">Rp 10.000</span>
            </div>

            <!-- Tab Selection Buttons -->
            <div class="grid grid-cols-2 gap-2 mb-6 font-headline font-bold">
                <button id="tab-btn-qris" onclick="switchPaymentTab('qris')" class="py-3 border-2 border-ink bg-ink text-parchment text-center rounded">
